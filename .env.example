# =============================================================
# GeoChange AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# =============================================================

# ─── Application ─────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Frontend ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ─── Google Earth Engine ─────────────────────────────────────
# Required after GEE account approval.
# Steps: https://developers.google.com/earth-engine/guides/python_install
#
# Option A — Interactive user authentication (local development):
#   Run: earthengine authenticate
#   This stores a token at ~/.config/earthengine/credentials
#   Set GEE_AUTH_MODE=user below.
#
# Option B — Service account (Docker / server deployment):
#   Create a service account in Google Cloud Console.
#   Download the JSON key and set GEE_SERVICE_ACCOUNT_KEY_PATH.
#   Set GEE_AUTH_MODE=service_account below.
#
GEE_AUTH_MODE=user
GEE_PROJECT_ID=your-google-cloud-project-id
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=./configs/gee_service_account_key.json

# ─── SQLite Database ─────────────────────────────────────────
SQLITE_DB_PATH=./backend/geochange.db

# ─── ML / Model Artifacts ────────────────────────────────────
MODEL_ARTIFACTS_DIR=./artifacts/models
EXPORT_DIR=./artifacts/exports
MLFLOW_TRACKING_URI=./artifacts/mlruns

# ─── CORS (allowed frontend origins) ─────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./backend/logs/geochange.log

# ─── Study Area Defaults ─────────────────────────────────────
DEFAULT_STUDY_AREA=coimbatore
DEFAULT_START_YEAR=2018
DEFAULT_END_YEAR=2024
